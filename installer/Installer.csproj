<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultItems>false</EnableDefaultItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>None</DebugType>
    <AssemblyName>OraxHotel-Setup</AssemblyName>
    <Version>1.0.0</Version>
    <Company>Orax Hotel</Company>
    <Product>Orax Hotel Windows Installer</Product>
    <Description>Self-contained silent installer for Orax Hotel.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
  <!-- موارد مضمّنة اختيارية: تُضمّن فقط إن وُجدت أثناء البناء -->
  <ItemGroup Condition="Exists('installer-config.json')">
    <EmbeddedResource Include="installer-config.json" LogicalName="installer-config.json" />
  </ItemGroup>
  <ItemGroup Condition="Exists('7zr.exe')">
    <EmbeddedResource Include="7zr.exe" LogicalName="7zr.exe" />
  </ItemGroup>
  <ItemGroup Condition="Exists('payload.7z')">
    <EmbeddedResource Include="payload.7z" LogicalName="payload.7z" />
  </ItemGroup>
</Project>
